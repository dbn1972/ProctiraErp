{
  "search.followSymlinks": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/.pnpm": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/coverage": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/.lighthouseci": true,
    "**/.dart_tool": true,
    "**/.pub-cache": true,
    "**/tsconfig.tsbuildinfo": true,
    "apps/**/screens": true,
    "apps/mobile/android": true,
    "apps/mobile/ios": true,
    "apps/mobile/linux": true,
    "apps/mobile/macos": true,
    "apps/mobile/windows": true,
    "pnpm-lock.yaml": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/.pnpm/**": true,
    "**/.git/objects/**": true,
    "**/.git/cursor/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true,
    "**/coverage/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/.lighthouseci/**": true,
    "**/.dart_tool/**": true,
    "**/.pub-cache/**": true,
    "**/*.tsbuildinfo": true,
    "apps/**/screens/**": true,
    "apps/mobile/android/**": true,
    "apps/mobile/ios/**": true,
    "apps/mobile/linux/**": true,
    "apps/mobile/macos/**": true,
    "apps/mobile/windows/**": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.dart_tool": true
  },
  "npm.autoDetect": "off",
  "task.autoDetect": "off",
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling",
    "synchronousWatchDirectory": false,
    "excludeDirectories": [
      "**/node_modules",
      "**/.git",
      "**/.next",
      "**/dist",
      "**/build",
      "**/.turbo",
      "**/coverage",
      "**/.dart_tool",
      "**/test-results",
      "**/playwright-report"
    ]
  },
  "eslint.run": "onSave",
  "eslint.quiet": true,
  "dart.analysisExcludedFolders": [
    "apps/mobile/android",
    "apps/mobile/ios",
    "apps/mobile/linux",
    "apps/mobile/macos",
    "apps/mobile/windows",
    "apps/mobile/build",
    "apps/mobile/.dart_tool"
  ]
}
