{
  "name": "proctira-erp",
  "version": "0.1.0",
  "private": true,
  "description": "ProctiraERP - Education Management System",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "lint:a11y": "node tools/scripts/check-icon-only-button.mjs",
    "check:contrast": "node tools/scripts/check-contrast.mjs",
    "check:bundle": "node tools/scripts/check-bundle.mjs",
    "check:lighthouse": "node tools/scripts/check-lighthouse.mjs",
    "check:brand-strings": "node tools/scripts/check-brand-strings.mjs",
    "check:i18n": "node tools/scripts/check-i18n.mjs",
    "lint:brand": "node tools/scripts/check-brand-strings-eslint.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "check:dod": "pnpm --filter @proctira/dod-checks check",
    "check:dod:strict": "pnpm --filter @proctira/dod-checks check -- --strict",
    "check:dod:test": "pnpm --filter @proctira/dod-checks test",
    "check:dod:evidence": "node tools/scripts/assert-dod-evidence.mjs",
    "dod:check": "node tools/scripts/definition-of-done-checks.mjs",
    "dod:test": "node tools/scripts/definition-of-done-checks.test.mjs",
    "test:tenant-isolation": "pnpm --filter @proctira/tenant-isolation-tests run test:all",
    "test:tenant-isolation:unit": "pnpm --filter @proctira/tenant-isolation-tests run test:unit",
    "test:tenant-isolation:integration": "pnpm --filter @proctira/tenant-isolation-tests run test:integration",
    "test:tenant-isolation:e2e": "pnpm --filter @proctira/tenant-isolation-tests run test:e2e",
    "test:tenant-isolation:queue": "pnpm --filter @proctira/tenant-isolation-tests run test:queue",
    "test:tenant-isolation:search": "pnpm --filter @proctira/tenant-isolation-tests run test:search",
    "test:tenant-isolation:cache": "pnpm --filter @proctira/tenant-isolation-tests run test:cache",
    "test:tenant-isolation:report": "pnpm --filter @proctira/tenant-isolation-tests run test:report",
    "test:live": "vitest run --config tools/vitest.live-gate.config.ts",
    "test:live:assert": "node tools/scripts/assert-live-test-execution.mjs",
    "test:live:gate": "node tools/scripts/run-live-test-gate.mjs",
    "check:restore-drill": "bash tools/scripts/check-restore-drill-evidence.sh",
    "check:prisma-sql-drift": "node tools/scripts/check-prisma-sql-drift.mjs",
    "check:prisma-sql-drift:test": "node --test tools/scripts/check-prisma-sql-drift.test.mjs",
    "check:strict-tenant-fks": "node tools/scripts/check-strict-tenant-fks.mjs",
    "check:strict-tenant-fks:test": "node --test tools/scripts/check-strict-tenant-fks.test.mjs",
    "check:strict-tenant-fks:live": "node tools/scripts/check-strict-tenant-fks.mjs --live --require-live",
    "check:tenant-id-indexes": "node tools/scripts/check-tenant-id-indexes.mjs",
    "check:tenant-id-indexes:test": "node --test tools/scripts/check-tenant-id-indexes.test.mjs",
    "check:migration-timeouts": "node tools/scripts/check-migration-timeouts.mjs",
    "check:migration-timeouts:test": "node --test tools/scripts/check-migration-timeouts.test.mjs tools/scripts/migration-lock-recovery-drill.test.mjs",
    "check:migration-lock-recovery": "node tools/scripts/migration-lock-recovery-drill.mjs",
    "check:codeowners": "node tools/scripts/check-codeowners.mjs",
    "check:codeowners:test": "node --test tools/scripts/check-codeowners.test.mjs",
    "check:runtime-table-privileges": "node tools/scripts/check-runtime-table-privileges.mjs",
    "check:runtime-table-privileges:test": "node --test tools/scripts/check-runtime-table-privileges.test.mjs",
    "check:runtime-role-gate": "node tools/scripts/check-runtime-role-gate.mjs",
    "check:runtime-role-gate:test": "node --test tools/scripts/assert-runtime-database-role.test.mjs tools/scripts/check-runtime-role-gate.test.mjs",
    "check:runtime-ddl": "node tools/scripts/check-no-runtime-ddl.mjs",
    "check:runtime-ddl:test": "node --test tools/scripts/check-no-runtime-ddl.test.mjs",
    "check:target-migration:test": "node --test tools/scripts/target-database-migration-contract.test.mjs",
    "check:reusable-ci-assets": "node tools/scripts/assert-reusable-ci-assets.mjs",
    "check:reusable-ci-assets:test": "node --test tools/scripts/assert-reusable-ci-assets.test.mjs",
    "check:observability": "node tools/scripts/validate-observability.mjs",
    "test:pg": "vitest run --config tools/vitest.pg-gate.config.ts",
    "test:pg:assert": "node tools/scripts/assert-vitest-skips.mjs",
    "test:pg:gate": "node tools/scripts/run-pg-test-gate.mjs",
    "test:coverage:assert": "node tools/scripts/assert-coverage-gate.mjs",
    "test:coverage:gate:test": "node --test tools/scripts/assert-coverage-gate.test.mjs",
    "check:turbo-filter-base:test": "node --test tools/scripts/resolve-turbo-filter-base.test.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-proctira": "workspace:*",
    "fast-check": "^4.10.1",
    "prettier": "^3.9.8",
    "turbo": "^2.10.13",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "packageExtensions": {
      "@hookform/resolvers": {
        "dependencies": {
          "zod": "^4.4.3"
        }
      }
    },
    "overrides": {
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@2": ">=2.1.4",
      "fast-uri@2": ">=2.4.5 <3",
      "fast-uri@3": ">=3.1.6",
      "nanoid@3": ">=3.3.18 <4",
      "postcss@8": ">=8.5.18",
      "tmp": ">=0.2.6",
      "browserslist": ">=4.28.7",
      "fast-jwt": ">=6.2.4",
      "next": "^15.5.21",
      "fastify": "^5.7.2",
      "@fastify/static": "^10.1.4",
      "@fastify/jwt": "^9.0.0"
    }
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
