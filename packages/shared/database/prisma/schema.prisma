// OpenEMIS Unified Platform - Prisma Schema
// PostgreSQL with Row-Level Security for multi-tenancy

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgTrgm(map: "pg_trgm")]
}

// ============================================================================
// TENANT
// ============================================================================

/// Represents a deploying organization (Ministry, State Dept, NGO).
/// NOT a school or board — those are data entities within a tenant.
model Tenant {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  config    Json?     @default("{}") @db.JsonB
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  geographicAreas GeographicArea[]
  boards          Board[]
  institutions    Institution[]
  students        Student[]
  staff           Staff[]
  enrollments     Enrollment[]
  enrollmentHistory EnrollmentHistory[]
  studentTransfers  StudentTransfer[]
  academicPeriods AcademicPeriod[]
  grades          Grade[]
  classes         Class[]
  users           User[]
  identities      UserIdentity[]
  refreshTokens   RefreshToken[]
  sessions        UserSession[]
  themeVersions   TenantThemeVersion[]
  themeDraft      TenantThemeDraft?
  studentAttendance StudentAttendance[]
  staffAttendance   StaffAttendance[]
  staffAssignments  StaffAssignment[]
  examinations      Examination[]
  examinationCandidateRegistrations ExaminationCandidateRegistration[]
  examinationCandidates             ExaminationCandidate[]
  examinationPublications           ExaminationPublication[]
  examinationResultAnalyses         ExaminationResultAnalysis[]
  examinationAcademicRecords        ExaminationAcademicRecord[]
  examinationDocumentJobs           ExaminationDocumentJob[]
  gradingSchemes     GradingScheme[]
  assessmentItems    AssessmentItem[]
  assessmentOutcomes AssessmentOutcome[]
  assessmentResults  AssessmentResult[]

  @@map("tenants")
}

// ============================================================================
// TENANT THEME VERSIONS (Task 58.2 - branding rollback / append-only)
// ============================================================================

/// Append-only history of published tenant theme tokens.
///
/// Each successful publish (or rollback) appends a new row. Rows are NEVER
/// updated or deleted — the table is the durable audit trail for theme
/// changes (Requirement 28 AC 4 / Design §N — "Versioned revisions").
///
/// `revision` is monotonically increasing per tenant. The current published
/// theme is the row with the highest `revision` for the tenant; tenant
/// settings (`tenants.config.theme`) mirror that row's `tokens` for fast
/// boot-time reads (Task 58.1).
///
/// On rollback, the rollback handler reads the row at the requested
/// `revision`, copies its `tokens` into `tenants.config.theme`, and APPENDS
/// a new row carrying the same tokens at the next revision number — so the
/// rollback itself is a first-class entry in the version history.
model TenantThemeVersion {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  revision    Int      @db.Integer
  tokens      Json     @db.JsonB
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  publishedBy String   @map("published_by") @db.Uuid

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, revision], map: "tenant_theme_versions_tenant_revision_key")
  @@index([tenantId])
  @@index([tenantId, publishedAt])
  @@map("tenant_theme_versions")
}

// ============================================================================
// TENANT THEME DRAFTS (Task 58.3 - preview cookie/header path)
// ============================================================================

/// In-progress branding token edits a tenant administrator is staging in
/// Settings → Branding before publishing. At most one draft per tenant.
///
/// Drafts are surfaced ONLY to requests that present the
/// `Tenant-Theme-Preview` cookie or `X-Tenant-Theme-Preview` header AND
/// originate from a user with `branding:preview` permission (Design §N).
/// Other callers always see the published tokens from
/// `tenant_theme_versions`.
model TenantThemeDraft {
  tenantId String   @id @map("tenant_id") @db.Uuid
  tokens   Json     @db.JsonB
  savedAt  DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)
  savedBy  String   @map("saved_by") @db.Uuid

  // Relations — cascade on tenant delete; the audit trail in
  // `tenant_theme_versions` is the durable record.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([savedBy])
  @@map("tenant_theme_drafts")
}

// ============================================================================
// AUTH - PLATFORM USERS (Keycloak is the IdP; this is the tenant projection)
// ============================================================================

/// Local user record linked to a Keycloak identity.
/// Passwords and realm roles live in Keycloak — this table stores tenant
/// membership, display fields, and India-first country context.
model User {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String    @db.VarChar(255)
  displayName String    @map("display_name") @db.VarChar(255)
  firstName   String    @map("first_name") @db.VarChar(100)
  lastName    String    @map("last_name") @db.VarChar(100)
  status      String    @default("active") @db.VarChar(20)
  countryCode String    @default("IN") @map("country_code") @db.VarChar(2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  identities UserIdentity[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

/// External identity link. Phase 2 provider is Keycloak (`keycloak`).
model UserIdentity {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  provider   String    @db.VarChar(50)
  externalId String    @map("external_id") @db.VarChar(255)
  email      String    @db.VarChar(255)
  realm      String    @default("proctira") @db.VarChar(100)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([provider, externalId])
  @@index([tenantId, email])
  @@map("user_identities")
}

// ============================================================================
// AUTH - REFRESH TOKENS
// ============================================================================

/// Refresh tokens stored in PostgreSQL with revocation tracking.
/// Supports token rotation: when a token is used, it's revoked and replaced.
model RefreshToken {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token           String    @unique @db.VarChar(255)
  userId          String    @map("user_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  revoked         Boolean   @default(false)
  revokedAt       DateTime? @map("revoked_at")
  revokedReason   String?   @map("revoked_reason") @db.VarChar(255)
  replacedByToken String?   @map("replaced_by_token") @db.VarChar(255)
  createdByIp     String?   @map("created_by_ip") @db.VarChar(45)
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  session UserSession? @relation(fields: [sessionId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, sessionId])
  @@index([expiresAt])
  @@index([revoked])
  @@map("refresh_tokens")
}

// ============================================================================
// AUTH - USER SESSIONS
// ============================================================================

/// User sessions valid across all platform modules.
/// Sessions track active user sessions with device info and last activity.
model UserSession {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  isActive       Boolean   @default(true) @map("is_active")
  userAgent      String?   @map("user_agent") @db.VarChar(500)
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  invalidatedAt  DateTime? @map("invalidated_at")

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@index([tenantId, userId])
  @@index([tenantId, isActive])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ============================================================================
// GEOGRAPHIC AREA HIERARCHY
// ============================================================================

/// Geographic/administrative hierarchy using nested set model.
/// Supports: Country → State → District → Sub-District → Block → Village
model GeographicArea {
  id       String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String  @db.VarChar(255)
  code     String  @db.VarChar(50)
  level    Int     @db.SmallInt
  parentId String? @map("parent_id") @db.Uuid
  path     String  @db.Text
  lft      Int
  rgt      Int

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  parent       GeographicArea?  @relation("AreaHierarchy", fields: [parentId], references: [id])
  children     GeographicArea[] @relation("AreaHierarchy")
  institutions Institution[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, level])
  @@index([tenantId, lft, rgt])
  @@map("geographic_areas")
}

// ============================================================================
// BOARD (Education Board - CBSE, ICSE, State Boards)
// ============================================================================

/// Education board within a tenant. Boards are data entities, not tenants.
model Board {
  id       String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  name     String    @db.VarChar(255)
  code     String    @db.VarChar(50)
  type     BoardType
  status   String    @default("active") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  institutions Institution[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("boards")
}

enum BoardType {
  NATIONAL
  STATE
  PRIVATE

  @@map("board_type")
}

// ============================================================================
// INSTITUTION (School)
// ============================================================================

/// Educational institution managed within a tenant.
model Institution {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  name       String  @db.VarChar(255)
  code       String  @db.VarChar(50)
  boardId    String? @map("board_id") @db.Uuid
  areaId     String  @map("area_id") @db.Uuid
  type       String  @db.VarChar(50)
  sector     String  @db.VarChar(50)
  ownership  String  @db.VarChar(50)
  status     String  @default("active") @db.VarChar(20)
  customData Json?   @default("{}") @map("custom_data") @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  board       Board?         @relation(fields: [boardId], references: [id])
  area        GeographicArea @relation(fields: [areaId], references: [id])
  enrollments Enrollment[]
  classes     Class[]

  @@unique([tenantId, code])
  @@index([tenantId, areaId])
  @@index([tenantId, boardId])
  @@index([tenantId, status])
  @@index([customData], type: Gin)
  @@map("institutions")
}

// ============================================================================
// STUDENT
// ============================================================================

/// Student record with full-text search support.
model Student {
  id           String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  firstName    String                   @map("first_name") @db.VarChar(100)
  lastName     String                   @map("last_name") @db.VarChar(100)
  dateOfBirth  DateTime                 @map("date_of_birth") @db.Date
  gender       String                   @db.VarChar(20)
  nationalId   String?                  @map("national_id") @db.VarChar(50)
  customData   Json?                    @default("{}") @map("custom_data") @db.JsonB
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  enrollments Enrollment[]

  @@unique([tenantId, nationalId])
  @@index([tenantId, lastName, firstName])
  @@index([customData], type: Gin)
  @@index([searchVector], type: Gin)
  @@map("students")
}

// ============================================================================
// STAFF
// ============================================================================

/// Staff record with full-text search support.
model Staff {
  id             String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  firstName      String                   @map("first_name") @db.VarChar(100)
  lastName       String                   @map("last_name") @db.VarChar(100)
  dateOfBirth    DateTime                 @map("date_of_birth") @db.Date
  identityNumber String                   @map("identity_number") @db.VarChar(50)
  customData     Json?                    @default("{}") @map("custom_data") @db.JsonB
  searchVector   Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, identityNumber])
  @@index([tenantId, lastName, firstName])
  @@index([customData], type: Gin)
  @@index([searchVector], type: Gin)
  @@map("staff")
}

// ============================================================================
// ENROLLMENT
// ============================================================================

/// Tracks student enrollment at an institution for an academic period.
model Enrollment {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  institutionId    String           @map("institution_id") @db.Uuid
  gradeId          String           @map("grade_id") @db.Uuid
  classId          String?          @map("class_id") @db.Uuid
  academicPeriodId String           @map("academic_period_id") @db.Uuid
  status           EnrollmentStatus @default(ENROLLED)
  enrolledAt       DateTime         @map("enrolled_at") @db.Date
  exitedAt         DateTime?        @map("exited_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])
  institution    Institution    @relation(fields: [institutionId], references: [id])
  grade          Grade          @relation(fields: [gradeId], references: [id])
  class          Class?         @relation(fields: [classId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  history        EnrollmentHistory[]

  @@index([tenantId, studentId])
  @@index([tenantId, institutionId, academicPeriodId])
  @@index([tenantId, status])
  @@map("enrollments")
}

/// Status-change audit trail for an enrollment.
model EnrollmentHistory {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  enrollmentId     String   @map("enrollment_id") @db.Uuid
  previousStatus   String?  @map("previous_status") @db.VarChar(20)
  newStatus        String   @map("new_status") @db.VarChar(20)
  effectiveDate    DateTime @map("effective_date") @db.Date
  institutionId    String   @map("institution_id") @db.Uuid
  academicPeriodId String   @map("academic_period_id") @db.Uuid
  reason           String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, enrollmentId])
  @@map("enrollment_history")
}

/// Transfer record linking source and destination institutions.
model StudentTransfer {
  id                       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  studentId                String   @map("student_id") @db.Uuid
  sourceInstitutionId      String   @map("source_institution_id") @db.Uuid
  sourceEnrollmentId       String   @map("source_enrollment_id") @db.Uuid
  destinationInstitutionId String   @map("destination_institution_id") @db.Uuid
  destinationEnrollmentId  String   @map("destination_enrollment_id") @db.Uuid
  transferDate             DateTime @map("transfer_date") @db.Date
  reason                   String   @db.VarChar(500)
  createdAt                DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, studentId])
  @@map("student_transfers")
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED
  WITHDRAWN
  GRADUATED

  @@map("enrollment_status")
}

// ============================================================================
// ACADEMIC PERIOD
// ============================================================================

/// Configurable time boundary (year, semester, term) that scopes institutional data.
model AcademicPeriod {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(50)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("active") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  enrollments Enrollment[]
  classes     Class[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("academic_periods")
}

// ============================================================================
// GRADE
// ============================================================================

/// Education grade level within a tenant.
model Grade {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(100)
  code     String @db.VarChar(50)
  order    Int    @db.SmallInt

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  enrollments Enrollment[]
  classes     Class[]

  @@unique([tenantId, code])
  @@index([tenantId, order])
  @@map("grades")
}

// ============================================================================
// CLASS
// ============================================================================

/// A class within an institution, assigned to a grade and academic period.
model Class {
  id               String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  institutionId    String @map("institution_id") @db.Uuid
  gradeId          String @map("grade_id") @db.Uuid
  academicPeriodId String @map("academic_period_id") @db.Uuid
  name             String @db.VarChar(100)
  capacity         Int?   @db.SmallInt

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  institution    Institution    @relation(fields: [institutionId], references: [id])
  grade          Grade          @relation(fields: [gradeId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  enrollments    Enrollment[]

  @@index([tenantId, institutionId, academicPeriodId])
  @@index([tenantId, gradeId])
  @@map("classes")
}

// ============================================================================
// SUBJECT
// ============================================================================

/// A subject offered within a tenant, linked to grades via SubjectGrade.
model Subject {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(255)
  code     String @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  grades InstitutionSubject[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

// ============================================================================
// INSTITUTION SUBJECT (links subjects to grades within an institution)
// ============================================================================

/// Links a subject to a grade within a specific institution.
/// Each subject must be linked to at least one grade within the institution.
model InstitutionSubject {
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  institutionId String @map("institution_id") @db.Uuid
  subjectId     String @map("subject_id") @db.Uuid
  gradeId       String @map("grade_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([tenantId, institutionId, subjectId, gradeId])
  @@index([tenantId, institutionId, gradeId])
  @@map("institution_subjects")
}

// ============================================================================
// STUDENT ATTENDANCE (Requirement 9.1-9.3, 9.7)
// ============================================================================

/// A single student attendance record for a class on a date. When the
/// institution records by subject or period, `subjectId` / `periodId` pin the
/// record to that dimension; in plain class mode both are null.
///
/// Uniqueness is enforced in the service (find-then-write), not by a DB unique
/// constraint, because nullable `subjectId`/`periodId` make a composite unique
/// unreliable (NULLs compare distinct in Postgres) — this mirrors the prior
/// in-memory behavior. The indexes below cover the roster, percentage, and
/// absence-count query paths.
model StudentAttendance {
  id               String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  studentId        String  @map("student_id") @db.Uuid
  institutionId    String  @map("institution_id") @db.Uuid
  classId          String  @map("class_id") @db.Uuid
  academicPeriodId String  @map("academic_period_id") @db.Uuid
  date             DateTime @db.Date
  subjectId        String? @map("subject_id") @db.Uuid
  periodId         String? @map("period_id") @db.Uuid
  status           String  @db.VarChar(20)
  comment          String? @db.Text
  recordedBy       String  @map("recorded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, classId, date])
  @@index([tenantId, studentId, classId, date])
  @@index([tenantId, institutionId, date])
  @@index([tenantId, studentId, date])
  @@map("student_attendance")
}

// ============================================================================
// STAFF ATTENDANCE (Requirement 9.1-9.3)
// ============================================================================

/// A single staff attendance record for a date. One record per
/// (tenant, staff, date) — enforced by the unique constraint below.
model StaffAttendance {
  id            String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  staffId       String  @map("staff_id") @db.Uuid
  institutionId String  @map("institution_id") @db.Uuid
  date          DateTime @db.Date
  status        String  @db.VarChar(20)
  leaveTypeId   String? @map("leave_type_id") @db.Uuid
  comment       String? @db.Text
  recordedBy    String  @map("recorded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, staffId, date])
  @@index([tenantId, institutionId, date])
  @@map("staff_attendance")
}

// ============================================================================
// ATTENDANCE AUDIT (Requirement 9.6 - change trail with previous status)
// ============================================================================

/// Append-only trail of student-attendance status changes.
///
/// The repository contract (`createAuditEntry` / `getAuditEntriesForAttendance`)
/// carries no tenant id, so — like `PrismaInstitutionRepository.findByCode` —
/// this table is NOT under RLS. Isolation rests on the unguessable parent
/// `student_attendance.id` (UUID v4) it references, and that parent table IS
/// RLS-protected. Promoting this to full RLS requires adding `tenantId` to the
/// `AttendanceAuditEntry` contract (tracked as follow-up).
model AttendanceAudit {
  id             String   @id @db.Uuid
  attendanceId   String   @map("attendance_id") @db.Uuid
  previousStatus String?  @map("previous_status") @db.VarChar(20)
  newStatus      String   @map("new_status") @db.VarChar(20)
  changedBy      String   @map("changed_by") @db.Uuid
  changedAt      DateTime @map("changed_at")

  @@index([attendanceId])
  @@map("attendance_audit")
}

// ============================================================================
// STAFF ASSIGNMENT (Requirement 7.2 - non-overlap + allocation constraints)
// ============================================================================

/// A staff member's teaching assignment to an institution/subject/class for a
/// date range. `endDate` null means ongoing. Overlap and total-allocation
/// constraints are enforced in StaffAssignmentService (find-then-write), not
/// by DB constraints, mirroring the prior in-memory behavior. Hard delete.
model StaffAssignment {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  staffId              String    @map("staff_id") @db.Uuid
  institutionId        String    @map("institution_id") @db.Uuid
  subjectId            String    @map("subject_id") @db.Uuid
  classId              String    @map("class_id") @db.Uuid
  role                 String    @db.VarChar(100)
  allocationPercentage Int       @map("allocation_percentage") @db.SmallInt
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime? @map("end_date") @db.Date
  status               String    @default("ACTIVE") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, staffId, status])
  @@index([tenantId, institutionId])
  @@index([tenantId, staffId, institutionId, subjectId, classId])
  @@map("staff_assignments")
}

// ============================================================================
// EXAMINATION (Requirement 10.x)
// ============================================================================

/// A formal examination. The nested collections (subjects, centers, sessions,
/// gradingSchemes) are owned 1:N value objects always read/written with the
/// parent, so they are stored as JSONB arrays on this row — same envelope
/// strategy as Institution/Staff `__profile` — rather than as child tables.
model Examination {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String   @db.VarChar(255)
  code             String   @db.VarChar(50)
  description      String?  @db.Text
  academicPeriodId String   @map("academic_period_id") @db.Uuid
  startDate        DateTime @map("start_date") @db.Date
  endDate          DateTime @map("end_date") @db.Date
  status           String   @default("DRAFT") @db.VarChar(20)
  subjects         Json     @default("[]") @db.JsonB
  centers          Json     @default("[]") @db.JsonB
  sessions         Json     @default("[]") @db.JsonB
  gradingSchemes   Json     @default("[]") @map("grading_schemes") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, academicPeriodId])
  @@index([tenantId, status])
  @@map("examinations")
}

/// A student's registration as an examination candidate (Req 10.2).
model ExaminationCandidateRegistration {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  examinationId String   @map("examination_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  centerId      String   @map("center_id") @db.Uuid
  subjectIds    Json     @default("[]") @map("subject_ids") @db.JsonB
  status        String   @default("REGISTERED") @db.VarChar(20)
  registeredAt  DateTime @map("registered_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, examinationId, studentId])
  @@map("examination_candidate_registrations")
}

/// An examination candidate with per-subject score entries, used by result
/// publication. `subjectResults` is a JSONB array of
/// {candidateId, subjectId, score, isComplete}.
model ExaminationCandidate {
  id             String @id @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  examinationId  String @map("examination_id") @db.Uuid
  studentId      String @map("student_id") @db.Uuid
  centerId       String @map("center_id") @db.Uuid
  gender         String @db.VarChar(10)
  areaId         String @map("area_id") @db.Uuid
  subjectResults Json   @default("[]") @map("subject_results") @db.JsonB

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, examinationId, studentId])
  @@index([tenantId, examinationId, centerId])
  @@map("examination_candidates")
}

/// Snapshot of a result-publication run (one per examination). The full
/// PublicationResult aggregate (grade results + incomplete records) is stored
/// as JSONB — it is written/read whole, never queried by parts.
model ExaminationPublication {
  examinationId String   @map("examination_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  publishedAt   DateTime @map("published_at")
  payload       Json     @db.JsonB

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, examinationId])
  @@map("examination_publications")
}

/// Snapshot of a generated ResultAnalysis aggregate (one per examination),
/// stored whole as JSONB (read/written atomically, never queried by parts).
model ExaminationResultAnalysis {
  examinationId String   @map("examination_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  generatedAt   DateTime @map("generated_at")
  payload       Json     @db.JsonB

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, examinationId])
  @@map("examination_result_analyses")
}

/// Append-only academic-record updates pushed at publication time
/// (one row per student × subject × examination).
model ExaminationAcademicRecord {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  examinationId String   @map("examination_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  score         Float
  grade         String   @db.VarChar(20)
  passed        Boolean
  publishedAt   DateTime @map("published_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, studentId])
  @@index([tenantId, examinationId])
  @@map("examination_academic_records")
}

/// A document-generation job (admit cards, seating plans, certificates).
model ExaminationDocumentJob {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  examinationId   String    @map("examination_id") @db.Uuid
  documentType    String    @map("document_type") @db.VarChar(30)
  status          String    @default("queued") @db.VarChar(20)
  candidateIds    Json      @default("[]") @map("candidate_ids") @db.JsonB
  totalCandidates Int       @map("total_candidates")
  processedCount  Int       @default(0) @map("processed_count")
  failedCount     Int       @default(0) @map("failed_count")
  errorMessage    String?   @map("error_message") @db.Text
  outputPath      String?   @map("output_path") @db.Text
  durationMs      Int?      @map("duration_ms")
  createdAt       DateTime  @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, examinationId])
  @@map("examination_document_jobs")
}

// ============================================================================
// ASSESSMENT (Requirement 8.x - continuous assessment)
// ============================================================================

/// A grading scheme (numeric/letter/competency) with its grade thresholds
/// stored as a JSONB array of {grade, minScore, maxScore, descriptor?}.
/// Name uniqueness is enforced in the service via case-insensitive findByName
/// (no DB unique, matching the prior in-memory behavior).
model GradingScheme {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  name       String @db.VarChar(255)
  type       String @db.VarChar(20)
  minValue   Float  @map("min_value")
  maxValue   Float  @map("max_value")
  thresholds Json   @default("[]") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, name])
  @@index([tenantId, type])
  @@map("grading_schemes")
}

/// A weighted assessment item within a subject + academic period.
/// All items for a subject/period are replaced atomically
/// (replaceItemsForSubjectPeriod), and their weights must total 100.
model AssessmentItem {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  subjectId        String @map("subject_id") @db.Uuid
  academicPeriodId String @map("academic_period_id") @db.Uuid
  gradingSchemeId  String @map("grading_scheme_id") @db.Uuid
  name             String @db.VarChar(255)
  weight           Float
  maxScore         Float  @map("max_score")
  minScore         Float  @map("min_score")
  outcomeIds       Json   @default("[]") @map("outcome_ids") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, subjectId, academicPeriodId])
  @@map("assessment_items")
}

/// A curriculum outcome that assessment items can map to.
model AssessmentOutcome {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String  @db.VarChar(255)
  code        String  @db.VarChar(50)
  description String? @db.Text
  subjectId   String  @map("subject_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, subjectId])
  @@map("assessment_outcomes")
}

/// A student's score on one assessment item. Upsert key:
/// (tenant, student, assessment item) — enforced by the unique below.
model AssessmentResult {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  studentId        String @map("student_id") @db.Uuid
  assessmentItemId String @map("assessment_item_id") @db.Uuid
  subjectId        String @map("subject_id") @db.Uuid
  academicPeriodId String @map("academic_period_id") @db.Uuid
  score            Float

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, studentId, assessmentItemId])
  @@index([tenantId, subjectId, academicPeriodId])
  @@index([tenantId, assessmentItemId])
  @@map("assessment_results")
}
