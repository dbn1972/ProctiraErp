model RegistrationApplication {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  trackingNumber    String   @map("tracking_number") @db.VarChar(50)
  institutionId     String   @map("institution_id") @db.Uuid
  institutionName   String   @map("institution_name") @db.VarChar(255)
  status            String   @db.VarChar(30)
  firstName         String   @map("first_name") @db.VarChar(100)
  lastName          String   @map("last_name") @db.VarChar(100)
  dateOfBirth       String   @map("date_of_birth") @db.VarChar(32)
  gender            String   @db.VarChar(20)
  guardianName      String   @map("guardian_name") @db.VarChar(255)
  guardianPhone     String   @map("guardian_phone") @db.VarChar(50)
  guardianEmail     String?  @map("guardian_email") @db.VarChar(255)
  customFields      Json     @default("[]") @map("custom_fields") @db.JsonB
  documents         Json     @default("[]") @db.JsonB
  preferredLanguage String?  @map("preferred_language") @db.VarChar(20)
  remarks           String?  @db.Text
  submittedAt       DateTime @map("submitted_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, trackingNumber])
  @@index([tenantId, status])
  @@index([tenantId, institutionId])
  @@map("registration_applications")
  @@schema("registration")
}

/// Configurable registration form fields per institution type (Req 16.1).
/// `fields` is a JSONB array of FormFieldDefinition envelopes.
model FormConfiguration {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  institutionTypeId String   @map("institution_type_id") @db.VarChar(100)
  fields            Json     @default("[]") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // tenant_id / institution_type_id bare — no cross-schema FKs (charter §19)

  @@unique([tenantId, institutionTypeId])
  @@index([tenantId])
  @@map("form_configurations")
  @@schema("registration")
}

