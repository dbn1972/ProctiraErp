<?xml version="1.0" encoding="utf-8"?>
<!-- PRC-M046: exclude scanned documents from cloud backup and device transfer.
     PRC-M045: exclude downloaded reports likewise (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pending_documents/" />
        <exclude domain="file" path="reports/" />
        <exclude domain="root" path="cache/reports/" />
        <exclude domain="root" path="app_flutter/reports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pending_documents/" />
        <exclude domain="file" path="reports/" />
        <exclude domain="root" path="cache/reports/" />
        <exclude domain="root" path="app_flutter/reports/" />
    </device-transfer>
</data-extraction-rules>
