{
  "name": "@proctira/etl-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "node ../../tools/scripts/bundle-backend-runtime.mjs --cwd . --entry src/server.ts --outfile dist/server.js",
    "dev": "tsx watch src/server.ts",
    "start": "node --import ../../tools/scripts/backend-runtime-resolve.mjs --enable-source-maps dist/server.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proctira/backend-etl": "workspace:*",
    "@proctira/common": "workspace:*",
    "@proctira/database": "workspace:*",
    "@proctira/logging": "workspace:*",
    "@proctira/observability": "workspace:*",
    "@proctira/tenant": "workspace:*",
    "@proctira/validation": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.7.2",
    "fastify-plugin": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "fast-check": "^4.10.1",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
