{
  "annotations": { "list": [] },
  "description": "Per-tenant request rate and error rate.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "uid": "proctira-tenant-overview",
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Top tenants by request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "topk(20, sum by (tenant_id) (rate(http_requests_total{tenant_id!=\"unknown\"}[$__rate_interval])))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Per-tenant 5xx ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(http_requests_total{tenant_id!=\"unknown\",status_code=~\"5..\"}[$__rate_interval])) / sum by (tenant_id) (rate(http_requests_total{tenant_id!=\"unknown\"}[$__rate_interval]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Per-tenant 4xx ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(http_requests_total{tenant_id!=\"unknown\",status_code=~\"4..\"}[$__rate_interval])) / sum by (tenant_id) (rate(http_requests_total{tenant_id!=\"unknown\"}[$__rate_interval]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    }
  ],
