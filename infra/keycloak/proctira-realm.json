{
  "realm": "proctira",
  "enabled": true,
  "displayName": "ProctiraERP",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "hi", "ta", "te", "mr", "bn", "gu", "kn", "ar"],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      { "name": "super-admin", "description": "Platform super administrator" },
      { "name": "admin", "description": "School / tenant administrator" },
      { "name": "principal", "description": "Institution principal" },
      { "name": "teacher", "description": "Teacher" },
      { "name": "staff", "description": "Non-teaching staff" },
      { "name": "guardian", "description": "Parent or guardian" },
      { "name": "platform_admin", "description": "Platform administrator (control plane)" },
      { "name": "registrar", "description": "Student records / registration officer" },
      { "name": "bursar", "description": "Finance / bursar" },
      { "name": "hr_officer", "description": "Human resources officer" },
      { "name": "staff_admin", "description": "Staff / HR administrator" },
      { "name": "examinations_officer", "description": "Examinations officer" },
      { "name": "admissions_officer", "description": "Admissions officer" },
      { "name": "counsellor", "description": "Student counsellor (case worker)" },
      { "name": "communications_officer", "description": "Communications officer" },
      { "name": "notification_admin", "description": "Notification administrator" },
      { "name": "health_admin", "description": "Health administrator (tenant-wide PHI)" },
