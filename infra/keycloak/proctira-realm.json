      { "name": "etl_engineer", "description": "ETL / data integration engineer" },
      { "name": "transport_officer", "description": "Transport officer" },
      { "name": "timetable_officer", "description": "Timetable / scheduling officer" },
      { "name": "subject_teacher", "description": "Subject teacher" },
      { "name": "class_teacher", "description": "Class teacher" },
      { "name": "discipline_officer", "description": "Discipline officer (case worker)" },
      { "name": "marks_clerk", "description": "Marks entry clerk" },
      { "name": "scholarship_officer", "description": "Scholarship / financial aid officer" },
      { "name": "board_admin", "description": "Examination board administrator" },
      { "name": "board_officer", "description": "Examination board officer" },
      { "name": "board_regional_officer", "description": "Board regional officer" },
      { "name": "ministry_admin", "description": "Ministry / country administrator" },
      { "name": "state_admin", "description": "State administrator" },
      { "name": "state_director", "description": "State education director" },
      { "name": "parent", "description": "Parent portal user" },
      { "name": "student", "description": "Student portal user" },
      { "name": "applicant", "description": "Scholarship / admission applicant" }
    ]
  },
  "clients": [
    {
      "clientId": "proctira-gateway",
      "name": "Proctira API Gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "proctira-gateway-dev-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:3200/api/v1/auth/callback",
        "http://localhost:3000/api/v1/auth/callback",
        "http://127.0.0.1:3200/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3201",
        "http://127.0.0.1:3201",
        "http://localhost:3001",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:3201/*##http://localhost:3201/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "tenant_slug",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_slug",
            "claim.name": "tenant_slug",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "country",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "country",
            "claim.name": "country",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
