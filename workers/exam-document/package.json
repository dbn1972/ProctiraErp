{
  "name": "@proctira/exam-document-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ../../tools/scripts/bundle-backend-runtime.mjs --cwd . --entry src/main.ts --outfile dist/main.js",
    "dev": "tsx watch src/main.ts",
    "start": "node --import ../../tools/scripts/backend-runtime-resolve.mjs --enable-source-maps dist/main.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proctira/backend-examination": "workspace:*",
    "@proctira/common": "workspace:*",
    "@proctira/database": "workspace:*",
    "@proctira/queue-abstraction": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
