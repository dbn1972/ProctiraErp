# Dependencies — installed inside the image
**/node_modules
**/.pnpm-store

# Build artifacts — re-built inside the image
**/dist
**/.next
**/out
**/build
**/.turbo
**/tsconfig.tsbuildinfo

# Tooling caches
**/.cache
**/coverage
**/test-results
**/playwright-report

# VCS, IDE, OS
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.editorconfig
**/.DS_Store
Thumbs.db

# Environment files — never bake secrets into images
.env
.env.*
!.env.example
**/.env
**/.env.*
**/!.env.example

# Logs
*.log
**/*.log
logs

# Tests / fixtures (kept out of production images)
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/e2e

# Docs
**/*.md
!README.md
!**/README.md

# Misc
*.tar
*.tgz
*.zip
