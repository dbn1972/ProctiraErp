# =============================================================================
# ProctiraERP — cloudsphere-ec3 port profile
# =============================================================================
# OneDev / ShipGuard already bind 5432, 5433, 6379, 6380, 3001, 8080, 8929.
# Copy this file to `.env` on that host before `docker compose up`.
# Keep `.env` out of rsync --delete (this file is the durable template).
# Start infrastructure only:
#     docker compose --env-file .env up -d postgres redis keycloak
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
DEFAULT_COUNTRY_CODE=IN

POSTGRES_USER=proctira
POSTGRES_PASSWORD=proctira_dev_password
POSTGRES_DB=proctira
POSTGRES_PORT=5434
DATABASE_URL=postgresql://proctira:proctira_dev_password@postgres:5432/proctira?schema=public
DATABASE_URL_HOST=postgresql://proctira:proctira_dev_password@127.0.0.1:5434/proctira?schema=public

REDIS_PORT=6381
REDIS_URL=redis://redis:6379
REDIS_URL_HOST=redis://127.0.0.1:6381

KAFKA_PORT=9094
KAFKA_INTERNAL_PORT=29092
KAFKA_BROKERS=kafka:29092
KAFKA_BROKERS_HOST=localhost:9094
KAFKA_CLIENT_ID=proctira-platform

RABBITMQ_DEFAULT_USER=proctira
RABBITMQ_DEFAULT_PASS=proctira_dev_password
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
RABBITMQ_URL=amqp://proctira:proctira_dev_password@rabbitmq:5672

MINIO_ROOT_USER=proctira
MINIO_ROOT_PASSWORD=proctira_dev_password
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=proctira
S3_SECRET_KEY=proctira_dev_password
S3_BUCKET=proctira
S3_FORCE_PATH_STYLE=true

KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=proctira
KEYCLOAK_CLIENT_ID=proctira-gateway
KEYCLOAK_CLIENT_SECRET=proctira-gateway-dev-secret
KEYCLOAK_ISSUER=http://127.0.0.1:8180/realms/proctira
KEYCLOAK_JWKS_URI=http://127.0.0.1:8180/realms/proctira/protocol/openid-connect/certs
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:3200/api/v1/auth/callback

JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ISSUER=proctira-platform
JWT_AUDIENCE=proctira-api
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=change-me-cookie-signing-secret-also-random
AUTH_SERVICE_URL=http://api-gateway:3000

GATEWAY_PORT=3200
GATEWAY_HOST=0.0.0.0
GATEWAY_URL=http://api-gateway:3000
CORS_ORIGINS=http://localhost:3201,http://localhost:3202,http://localhost:3203,http://localhost:3204,http://localhost:3205
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

TENANT_BASE_DOMAIN=proctira.localhost
TENANT_HEADER_NAME=x-tenant-id

WEB_PORT=3201
REGISTRATION_PORTAL_PORT=3202
PUBLIC_WEBSITE_PORT=3203
ADMIN_CONSOLE_PORT=3204
DEVELOPER_PORTAL_PORT=3205
INSTALL_WIZARD_PORT=3210

NEXT_PUBLIC_API_URL=http://localhost:3200
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:3200
GATEWAY_URL=http://127.0.0.1:3200
NEXT_PUBLIC_WEB_URL=http://localhost:3201
NEXT_PUBLIC_REGISTRATION_PORTAL_URL=http://localhost:3202
NEXT_PUBLIC_PUBLIC_WEBSITE_URL=http://localhost:3203
NEXT_PUBLIC_ADMIN_CONSOLE_URL=http://localhost:3204
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=http://localhost:3205

ETL_WORKER_PORT=3220
ETL_WORKER_HOST=0.0.0.0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@proctira.localhost
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# MFA / SMS OTP — leave TWILIO_* empty on EC3 until secrets are provisioned;
# ConsoleSmsProvider logs OTPs to the gateway container stdout.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MFA_EXPOSE_OTP=false
# FCM_ANDROID_GOOGLE_SERVICES_JSON=/secure/fcm/google-services.json
# FCM_IOS_GOOGLE_SERVICE_INFO_PLIST=/secure/fcm/GoogleService-Info.plist
