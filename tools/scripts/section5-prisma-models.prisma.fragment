// --- §5 P18–P26 models ---

model FeeStructure {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name String @map("name") @db.VarChar(255)
  academicYear String @map("academic_year") @db.VarChar(255)
  amount Float @map("amount")
  currency String @default("INR") @map("currency") @db.VarChar(255)
  frequency String @default("annual") @map("frequency") @db.VarChar(255)
  status String @default("active") @map("status") @db.VarChar(255)
  institutionId String? @map("institution_id") @db.Uuid
  gradeId String? @map("grade_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("fee_structures")
  @@schema("finance")
}

model Invoice {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  enrollmentId String? @map("enrollment_id") @db.Uuid
  feeStructureId String? @map("fee_structure_id") @db.Uuid
  institutionId String? @map("institution_id") @db.Uuid
  amountDue Float @map("amount_due")
  amountPaid Float @default(0) @map("amount_paid")
  currency String @default("INR") @map("currency") @db.VarChar(255)
  dueDate String @map("due_date") @db.VarChar(255)
  status String @default("open") @map("status") @db.VarChar(255)
  notes String? @map("notes") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("invoices")
  @@schema("finance")
}

model Payment {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  amount Float @map("amount")
  method String @default("cash") @map("method") @db.VarChar(255)
  reference String? @map("reference") @db.VarChar(255)
  paidAt String @map("paid_at") @db.VarChar(255)
  recordedByUserId String? @map("recorded_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("payments")
  @@schema("finance")
}

model BellPeriod {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  institutionId String @map("institution_id") @db.Uuid
  name String @map("name") @db.VarChar(255)
  periodOrder Float @map("period_order")
  startTime String @map("start_time") @db.VarChar(255)
  endTime String @map("end_time") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("bell_periods")
  @@schema("timetable")
}

model TimetableSlot {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  institutionId String @map("institution_id") @db.Uuid
  classId String @map("class_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  staffId String @map("staff_id") @db.Uuid
  bellPeriodId String @map("bell_period_id") @db.Uuid
  roomId String? @map("room_id") @db.Uuid
  dayOfWeek Float @map("day_of_week")
  status String @default("active") @map("status") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("timetable_slots")
  @@schema("timetable")
}

model Substitution {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  slotId String @map("slot_id") @db.Uuid
  originalStaffId String @map("original_staff_id") @db.Uuid
  substituteStaffId String @map("substitute_staff_id") @db.Uuid
  date String @map("date") @db.VarChar(255)
  reason String? @map("reason") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("substitutions")
  @@schema("timetable")
}

model LibraryTitle {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
