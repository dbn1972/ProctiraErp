}

model PayStructure {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name String @map("name") @db.VarChar(255)
  currency String @default("INR") @map("currency") @db.VarChar(255)
  components String @default("[]") @map("components") @db.Text
  status String @default("active") @map("status") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("pay_structures")
  @@schema("payroll")
}

model PayrollRun {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  payStructureId String? @map("pay_structure_id") @db.Uuid
  periodYear Float @map("period_year")
  periodMonth Float @map("period_month")
  status String @default("draft") @map("status") @db.VarChar(255)
  totalAmount Float @default(0) @map("total_amount")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("payroll_runs")
  @@schema("payroll")
}

model Payslip {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  payrollRunId String @map("payroll_run_id") @db.Uuid
  staffId String @map("staff_id") @db.Uuid
  grossAmount Float @map("gross_amount")
  netAmount Float @map("net_amount")
  status String @default("generated") @map("status") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("payslips")
  @@schema("payroll")
}

model AlumniProfile {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  studentId String? @map("student_id") @db.Uuid
  institutionId String? @map("institution_id") @db.Uuid
  fullName String @map("full_name") @db.VarChar(255)
  graduationYear Float @map("graduation_year")
  lastClassName String? @map("last_class_name") @db.VarChar(255)
  email String? @map("email") @db.VarChar(255)
  phone String? @map("phone") @db.VarChar(255)
  status String @default("active") @map("status") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("profiles")
  @@schema("alumni")
}

model AlumniEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  institutionId String? @map("institution_id") @db.Uuid
  title String @map("title") @db.VarChar(255)
  eventDate String @map("event_date") @db.VarChar(255)
  location String? @map("location") @db.VarChar(255)
