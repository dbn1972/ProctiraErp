model InventoryItem {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  institutionId String? @map("institution_id") @db.Uuid
  sku String @map("sku") @db.VarChar(255)
  name String @map("name") @db.VarChar(255)
  unit String @default("ea") @map("unit") @db.VarChar(255)
  quantityOnHand Float @default(0) @map("quantity_on_hand")
  reorderLevel Float @default(0) @map("reorder_level")
  status String @default("active") @map("status") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("items")
  @@schema("inventory")
}

model StockMovement {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  itemId String @map("item_id") @db.Uuid
  movementType String @map("movement_type") @db.VarChar(255)
  quantity Float @map("quantity")
  issuedToStaffId String? @map("issued_to_staff_id") @db.Uuid
  notes String? @map("notes") @db.Text
  movedAt String @map("moved_at") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("stock_movements")
  @@schema("inventory")
}

model MealMenu {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
