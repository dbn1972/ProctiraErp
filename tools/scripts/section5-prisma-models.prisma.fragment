model LibraryLoan {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  copyId String @map("copy_id") @db.Uuid
  borrowerId String @map("borrower_id") @db.Uuid
  borrowerType String @default("student") @map("borrower_type") @db.VarChar(255)
  loanedAt String @map("loaned_at") @db.VarChar(255)
  dueAt String @map("due_at") @db.VarChar(255)
  returnedAt String? @map("returned_at") @db.VarChar(255)
  fineInvoiceId String? @map("fine_invoice_id") @db.Uuid
  status String @default("active") @map("status") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
