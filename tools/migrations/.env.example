# Legacy MySQL Database (source)
LEGACY_MYSQL_HOST=localhost
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=proctira_core
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=

# Target PostgreSQL Database (destination)
TARGET_PG_HOST=localhost
TARGET_PG_PORT=5432
TARGET_PG_DATABASE=proctira_unified
TARGET_PG_USER=postgres
TARGET_PG_PASSWORD=
TARGET_PG_SCHEMA=public

# Migration Settings
MIGRATION_BATCH_SIZE=5000
MIGRATION_DEFAULT_TENANT_NAME=Default Organization
MIGRATION_DEFAULT_TENANT_SLUG=default
MIGRATION_STAGING_SCHEMA=migration_staging
MIGRATION_LOG_LEVEL=info

# pgloader path (if not in PATH)
PGLOADER_BIN=pgloader

# CDC (Change Data Capture) Incremental Sync
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=proctira-cdc-producer
CDC_CONSUMER_GROUP=proctira-cdc-consumers
CDC_TOPIC_PREFIX=cdc.migration
CDC_POLL_INTERVAL_MS=5000
CDC_BATCH_SIZE=1000
CDC_TENANT_ID=default
CDC_CONFLICT_RESOLUTION=source_wins
