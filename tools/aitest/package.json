{
  "name": "@proctira/aitest",
  "version": "0.1.0",
  "private": true,
  "description": "AI test program harnesses: throwaway stacks, synthetic tenants, tokens, inventories, reports. Live suites run only through vitest.aitest.config.ts / playwright.aitest.config.ts (nightly/weekly), never in PR CI.",
  "type": "module",
  "main": "./src/foundation/index.ts",
  "exports": {
    ".": "./src/foundation/index.ts"
  },
  "scripts": {
    "build": "echo 'aitest package consumed at source level - no build needed'",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "aitest": "tsx src/foundation/cli.ts"
  },
  "dependencies": {
    "@proctira/auth": "workspace:*",
    "@proctira/backend-assessment": "workspace:*",
    "@proctira/backend-fees": "workspace:*",
    "@proctira/backend-gradebook": "workspace:*",
    "@proctira/backend-institution": "workspace:*",
    "@proctira/backend-staff": "workspace:*",
    "@proctira/database": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.10.3",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7",
    "yaml": "2.9.1"
  }
}
