{
  "name": "@proctira/theme-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Theme development SDK for ProctiraERP platform - token definitions, validation, and preview utilities",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./validation": "./src/validation.ts",
    "./preview": "./src/preview.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proctira/backend-theme": "workspace:*",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "fast-check": "^4.10.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
