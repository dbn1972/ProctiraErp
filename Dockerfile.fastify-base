# syntax=docker/dockerfile:1.7
#
# Multi-stage base image for Fastify-based backend services and workers
# in the ProctiraERP Unified Platform monorepo.
#
# Per-service Dockerfiles consume this image (or copy these stages) and
# pass `APP_NAME` (the workspace name suffix, e.g. `api-gateway`) and
# `APP_DIR` (apps or packages/backend) so the runner copies the right
# build artifacts.
#
# Stages:
#   1. base    - Minimal Node + pnpm
#   2. deps    - Installs the workspace dependency graph
#   3. builder - Bundles the service to dist/ (W1-ARCH-09)
#   4. runner  - Lean runtime that boots compiled JS via `node dist/...`
#
# Local/dev continues to use `tsx` (see docker-compose.dev.yml / `pnpm dev`).
# All configuration is read from environment variables. No secrets baked in.

ARG NODE_VERSION=20-alpine

# ---------- 1. base ----------
FROM node:${NODE_VERSION} AS base
RUN apk add --no-cache libc6-compat curl tini
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /app

# ---------- 2. deps ----------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY plugins ./plugins
COPY themes ./themes
COPY tools ./tools
RUN pnpm install --frozen-lockfile

# ---------- 3. builder ----------
FROM deps AS builder
ARG APP_NAME=api-gateway
ARG APP_DIR=apps
ARG ENTRY=src/server.ts
ARG OUTFILE=dist/server.js
ENV NODE_ENV=production
# Emit a Node-runnable ESM bundle under dist/ (W1-ARCH-09). Typecheck remains
# a separate CI/`pnpm typecheck` concern; do not boot via tsx.
RUN node tools/scripts/bundle-backend-runtime.mjs \
      --cwd "${APP_DIR}/${APP_NAME}" \
      --entry "${ENTRY}" \
      --outfile "${OUTFILE}"

# ---------- 4. runner ----------
FROM node:${NODE_VERSION} AS runner
ARG APP_NAME=api-gateway
ARG APP_DIR=apps
ARG APP_PORT=3000
ARG HEALTH_PATH=/health
ARG OUTFILE=dist/server.js
RUN apk add --no-cache curl tini
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=${APP_PORT}
ENV HOST=0.0.0.0
ENV HEALTH_PATH=${HEALTH_PATH}

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs fastify

# Copy the entire built workspace. Symlinks under node_modules require the
# workspace tree to remain intact for Node module resolution of externals.
COPY --from=builder --chown=fastify:nodejs /app ./

USER fastify
EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl --fail "http://127.0.0.1:${PORT}${HEALTH_PATH}" || exit 1

ENV APP_DIR=${APP_DIR}
ENV APP_NAME=${APP_NAME}
ENV OUTFILE=${OUTFILE}

ENTRYPOINT ["/sbin/tini", "--"]
# Production boot: compiled JS only (W1-ARCH-09). Do not invoke tsx here.
# --import registers a pnpm workspace resolve fallback for transitive deps.
CMD ["sh", "-c", "cd ${APP_DIR}/${APP_NAME} && exec node --import /app/tools/scripts/backend-runtime-resolve.mjs --enable-source-maps ${OUTFILE}"]
