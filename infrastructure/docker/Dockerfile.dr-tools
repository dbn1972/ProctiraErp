# syntax=docker/dockerfile:1.7
# =============================================================================
# proctira-dr-tools — image for the disaster-recovery CronJobs (G-707)
# =============================================================================
# Small runtime containing psql/pg_dump/pg_restore plus the repo's DR scripts:
#   tools/scripts/pg-backup.sh          logical backup (custom format)
#   tools/scripts/pg-restore.sh         restore a backup
#   tools/scripts/restore-drill.sh      backup -> restore -> verify with evidence
#   tools/scripts/phi-retention-job.mjs PHI retention (dry-run unless RETENTION_DRY_RUN=0)
#
# Build context: monorepo root.
#   docker build -f infrastructure/docker/Dockerfile.dr-tools -t proctira/dr-tools .
# =============================================================================

ARG NODE_VERSION=20-alpine
FROM node:${NODE_VERSION}

# postgresql16-client must match the server major used by the platform
# (pg_dump from a newer client can read older servers, not the reverse).
RUN apk add --no-cache bash coreutils postgresql16-client python3 tini

RUN addgroup --system --gid 1001 dr \
 && adduser --system --uid 1001 --ingroup dr dr

WORKDIR /opt/proctira
COPY --chown=dr:dr tools/scripts/pg-backup.sh \
     tools/scripts/pg-restore.sh \
     tools/scripts/restore-drill.sh \
     tools/scripts/phi-retention-job.mjs \
     tools/scripts/
RUN chmod +x tools/scripts/*.sh

# Writable defaults for evidence + dumps; the Helm chart mounts a PVC here.
ENV BACKUP_DIR=/backups \
    ARTIFACT_DIR=/backups/evidence
RUN mkdir -p /backups/evidence && chown -R dr:dr /backups
VOLUME ["/backups"]

USER dr
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["bash", "tools/scripts/pg-backup.sh"]
