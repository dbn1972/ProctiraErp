# Rendered by tools/scripts/uatenv/uatenv-install-timer.sh into ~/.config/systemd/user/.
[Unit]
Description=ProctiraERP UAT nightly pg_dump (7-day retention)
After=docker.service

[Service]
Type=oneshot
Environment=UATENV_HOME=@UATENV_HOME@
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash @UATENV_HOME@/runtime/tooling/tools/scripts/uatenv/uatenv-backup.sh
StandardOutput=append:@UATENV_HOME@/runtime/logs/backup-nightly.log
StandardError=append:@UATENV_HOME@/runtime/logs/backup-nightly.log
Nice=10
IOSchedulingClass=idle
