# =============================================================================
# ProctiraERP Unified Platform — Environment Configuration
# =============================================================================
# Copy this file to `.env` for local development. NEVER commit `.env` files
# with real secrets to source control.
#
# All values default to settings appropriate for the bundled docker-compose
# stack. In production, override every secret and connection string.
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL (with PostGIS) — primary application database
# -----------------------------------------------------------------------------
POSTGRES_USER=proctira
POSTGRES_PASSWORD=proctira_dev_password
POSTGRES_DB=proctira
POSTGRES_PORT=5432
# Connection string consumed by Prisma and all backend services.
DATABASE_URL=postgresql://proctira:proctira_dev_password@postgres:5432/proctira?schema=public
# G-714: when DATABASE_URL is unset every domain falls back to an in-memory
# store (data lost on restart). Production refuses that fallback; set
# REQUIRE_DATABASE=1 anywhere else to fail fast instead of warning.
# REQUIRE_DATABASE=1
# ALLOW_IN_MEMORY_IN_PRODUCTION=0
# G-705: demo rows (scholarships, workflow/health UI seeds, db/sql/*b_*_seed.sql).
# Default: seeded only in dev/test with no DATABASE_URL. Never set in production.
# SEED_DEMO_DATA=0
# APPLY_SEEDS=0            # tools/scripts/apply-sql.sh — apply db/sql/*b_*_seed.sql
# APPLY_STRICT_FKS=0       # tools/scripts/apply-sql.sh — apply 021b tenant FK constraints

# -----------------------------------------------------------------------------
# Redis — cache, sessions, rate limiting
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Apache Kafka (KRaft mode, single node) — event streaming
# -----------------------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
# Brokers list as seen from inside the docker network.
KAFKA_BROKERS=kafka:29092
# Brokers list as seen from the host (use when running services locally).
KAFKA_BROKERS_HOST=localhost:9092
KAFKA_CLIENT_ID=proctira-platform

# -----------------------------------------------------------------------------
# RabbitMQ — task queues, dead-letter exchanges, delayed messages
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=proctira
RABBITMQ_DEFAULT_PASS=proctira_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://proctira:proctira_dev_password@rabbitmq:5672

# -----------------------------------------------------------------------------
# MinIO — S3-compatible object storage (reports, uploads, exports)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=proctira
MINIO_ROOT_PASSWORD=proctira_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=proctira
S3_SECRET_KEY=proctira_dev_password
S3_BUCKET=proctira
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Override these in production with cryptographically random values.
# G-703: with NODE_ENV=production the gateway refuses to boot when JWT_SECRET is
# missing, a known placeholder, or shorter than 32 characters.
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# G-504 rotation window: tokens signed with the previous secret stay valid.
# JWT_SECRET_PREVIOUS=
# G-713: Swagger UI at /docs is disabled in production unless DOCS_PUBLIC=1.
# DOCS_PUBLIC=0
JWT_ISSUER=proctira-platform
JWT_AUDIENCE=proctira-api
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=change-me-cookie-signing-secret-also-random
# G-711: PHI at rest (health counselling/screening notes). 32-byte key, base64 or
# hex. Required when NODE_ENV=production; encryption is a no-op without it in dev.
# PHI_ENCRYPTION_KEY=

# Auth service URL as seen by the API gateway and other services.
AUTH_SERVICE_URL=http://api-gateway:3000

# -----------------------------------------------------------------------------
# API Gateway
# -----------------------------------------------------------------------------
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
GATEWAY_URL=http://api-gateway:3000
# CORS allow-list (comma-separated).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Tenant resolution.
TENANT_BASE_DOMAIN=proctira.localhost
TENANT_HEADER_NAME=x-tenant-id

# -----------------------------------------------------------------------------
# Next.js apps — public-facing URLs and ports
# -----------------------------------------------------------------------------
WEB_PORT=3001
REGISTRATION_PORTAL_PORT=3002
PUBLIC_WEBSITE_PORT=3003
ADMIN_CONSOLE_PORT=3004
DEVELOPER_PORTAL_PORT=3005
INSTALL_WIZARD_PORT=3100

# Public API base URL exposed to the browser. In docker-compose this is the
# host-mapped gateway port.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3001
NEXT_PUBLIC_REGISTRATION_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_PUBLIC_WEBSITE_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_CONSOLE_URL=http://localhost:3004
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=http://localhost:3005

# -----------------------------------------------------------------------------
# ETL worker
# -----------------------------------------------------------------------------
ETL_WORKER_PORT=3010
ETL_WORKER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Notification channels (optional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@proctira.localhost
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Public status page probes (apps/public-website /status)
# -----------------------------------------------------------------------------
# When unset, /status stays in honest prelaunch mode (data-mode=prelaunch).
# docker-compose defaults these to in-network health endpoints for web + gateway.
# STATUS_PROBE_WEB_URL=http://web:3001/api/health
# STATUS_PROBE_API_URL=http://api-gateway:3000/health
# STATUS_PROBE_AUTH_URL=http://api-gateway:3000/health/live
STATUS_PROBE_WEB_URL=
STATUS_PROBE_API_URL=
STATUS_PROBE_AUTH_URL=

# -----------------------------------------------------------------------------
# Optional Keycloak IdP (peer-gap salvage — off by default)
# When KEYCLOAK_ISSUER + KEYCLOAK_CLIENT_ID are set, the API gateway verifies
# Keycloak RS256 tokens instead of local HS JWT. Identity/invite/OTP stores are
# in-memory on main (no Prisma User / UserIdentity models). Live Twilio SMS
# requires TWILIO_* secrets; otherwise OTP uses the console provider.
# -----------------------------------------------------------------------------
# KEYCLOAK_ISSUER=http://localhost:8080/realms/proctira
# KEYCLOAK_CLIENT_ID=proctira-gateway
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REALM=proctira
# KEYCLOAK_AUDIENCE=
# KEYCLOAK_JWKS_URI=
# KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# NEXT_PUBLIC_WEB_URL=http://localhost:3201
# MFA_EXPOSE_OTP=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
