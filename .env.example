# =============================================================================
# ProctiraERP Unified Platform — Environment Configuration
# =============================================================================
# Copy this file to `.env` for local development. NEVER commit `.env` files
# with real secrets to source control.
#
# All values default to settings appropriate for the bundled docker-compose
# stack. In production, override every secret and connection string.
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Observability (G-725) ---------------------------------------------------
# Every Fastify service serves Prometheus metrics at GET /metrics; set to false
# to opt out. There is NO OpenTelemetry exporter — TRACING_ENABLED and
# OTEL_EXPORTER_OTLP_ENDPOINT are not read by any service.
METRICS_ENABLED=true
# Alertmanager receivers (consumed by infra/observability/render-alertmanager.sh;
# unset optional keys route that severity to email instead of a dead receiver).
ALERT_EMAIL_TO=ops@example.org
ALERT_SMTP_FROM=alertmanager@example.org
ALERT_SMTP_SMARTHOST=smtp.example.org:587
PAGERDUTY_INTEGRATION_KEY=
SLACK_WEBHOOK_URL=
SLACK_SECURITY_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# PostgreSQL (with PostGIS) — primary application database
# -----------------------------------------------------------------------------
POSTGRES_USER=proctira
POSTGRES_PASSWORD=proctira_dev_password
POSTGRES_DB=proctira
POSTGRES_PORT=5432
# W1-DATA-01: migrator/owner URL for Prisma migrate + tools/scripts/apply-sql.sh.
# This role owns tables. Do not point application runtimes at it.
MIGRATOR_DATABASE_URL=postgresql://proctira:proctira_dev_password@postgres:5432/proctira?schema=public
# Runtime connection string for Prisma clients and all backend services.
# Must be the non-owner role proctira_app so ENABLE RLS constrains the app
# without relying on FORCE ROW LEVEL SECURITY alone.
DATABASE_URL=postgresql://proctira_app:proctira_app_dev_password@postgres:5432/proctira?schema=public
# Local compose bootstraps proctira_app via db/docker-init/01_app_runtime_role.sql
# (fresh volumes). Password must match that init script or your DBA ALTER ROLE.
# G-714: when DATABASE_URL is unset every domain falls back to an in-memory
# store (data lost on restart). Production refuses that fallback; set
# REQUIRE_DATABASE=1 anywhere else to fail fast instead of warning.
# REQUIRE_DATABASE=1
# ALLOW_IN_MEMORY_IN_PRODUCTION=0
# G-705: demo rows (scholarships, workflow/health UI seeds, db/sql/*b_*_seed.sql).
# Default: seeded only in dev/test with no DATABASE_URL. Never set in production.
# SEED_DEMO_DATA=0
# APPLY_SEEDS=0            # tools/scripts/apply-sql.sh — apply db/sql/*b_*_seed.sql
# APPLY_STRICT_FKS=0       # tools/scripts/apply-sql.sh — apply 021b tenant FK constraints

# -----------------------------------------------------------------------------
# Redis — cache, sessions, rate limiting
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Apache Kafka (KRaft mode, single node) — event streaming
# -----------------------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
# Brokers list as seen from inside the docker network.
KAFKA_BROKERS=kafka:29092
# Brokers list as seen from the host (use when running services locally).
KAFKA_BROKERS_HOST=localhost:9092
KAFKA_CLIENT_ID=proctira-platform

# -----------------------------------------------------------------------------
# RabbitMQ — task queues, dead-letter exchanges, delayed messages
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=proctira
RABBITMQ_DEFAULT_PASS=proctira_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://proctira:proctira_dev_password@rabbitmq:5672

# -----------------------------------------------------------------------------
# MinIO — S3-compatible object storage (reports, uploads, exports)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=proctira
MINIO_ROOT_PASSWORD=proctira_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=proctira
S3_SECRET_KEY=proctira_dev_password
S3_BUCKET=proctira
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Override these in production with cryptographically random values.
# G-703: with NODE_ENV=production the gateway refuses to boot when JWT_SECRET is
# missing, a known placeholder, or shorter than 32 characters.
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# G-504 rotation window: tokens signed with the previous secret stay valid.
# JWT_SECRET_PREVIOUS=
# G-713: Swagger UI at /docs is disabled in production unless DOCS_PUBLIC=1.
# DOCS_PUBLIC=0
JWT_ISSUER=proctira-platform
JWT_AUDIENCE=proctira-api
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=change-me-cookie-signing-secret-also-random
# G-711: PHI at rest (health counselling/screening notes). 32-byte key, base64 or
# hex. Required when NODE_ENV=production (boot + first PHI write throw without it,
# unless ALLOW_PLAINTEXT_PHI=1 is set explicitly); plaintext pass-through in dev.
# PHI_ENCRYPTION_KEY=
# ALLOW_PLAINTEXT_PHI=0

# Auth service URL as seen by the API gateway and other services.
AUTH_SERVICE_URL=http://api-gateway:3000

# P0-02: Auth shell demo honesty banner only (does NOT enable stub credentials).
# Leave unset / 0 in production. Set to 1 only for local/sandbox builds that
# should show the "Auth demo mode" banner on /login.
# NEXT_PUBLIC_AUTH_DEMO_MODE=0

# -----------------------------------------------------------------------------
# API Gateway
# -----------------------------------------------------------------------------
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
GATEWAY_URL=http://api-gateway:3000
# CORS allow-list (comma-separated).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Tenant resolution.
TENANT_BASE_DOMAIN=proctira.localhost
TENANT_HEADER_NAME=x-tenant-id

# -----------------------------------------------------------------------------
# Next.js apps — public-facing URLs and ports
# -----------------------------------------------------------------------------
WEB_PORT=3001
REGISTRATION_PORTAL_PORT=3002
PUBLIC_WEBSITE_PORT=3003
ADMIN_CONSOLE_PORT=3004
DEVELOPER_PORTAL_PORT=3005
INSTALL_WIZARD_PORT=3100

# Public API base URL exposed to the browser. In docker-compose this is the
# host-mapped gateway port.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3001
NEXT_PUBLIC_REGISTRATION_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_PUBLIC_WEBSITE_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_CONSOLE_URL=http://localhost:3004
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=http://localhost:3005

# Web auth cookies (G-719). The `Secure` attribute is ALWAYS set in production
# and whenever a request arrives over HTTPS (directly or via
# `x-forwarded-proto: https`). Set COOKIE_SECURE=1 to force it in non-production
# TLS environments. CSRF protection on the Next.js /api/* routes is always on:
# state-changing requests must carry the `csrf_token` cookie mirrored in the
# `x-csrf-token` header and originate from the same host.
# COOKIE_SECURE=1

# Generated PDFs (G-716). Report cards are written under REPORT_CARD_ARTIFACT_DIR
# (default: <os tmpdir>/proctira-report-cards) and served from
# GET /report-cards/jobs/:jobId/download. Set REPORT_CARD_ARTIFACT_STORE=memory
# for ephemeral test runs. Official transcripts live under SIS_TRANSCRIPT_DIR.
# REPORT_CARD_ARTIFACT_DIR=/var/lib/proctira/report-cards
# REPORT_CARD_ARTIFACT_STORE=filesystem
# SIS_TRANSCRIPT_DIR=/var/lib/proctira/sis-transcripts

# -----------------------------------------------------------------------------
# ETL worker
# -----------------------------------------------------------------------------
ETL_WORKER_PORT=3010
ETL_WORKER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Notification channels (optional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@proctira.localhost
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Public status page probes (apps/public-website /status)
# -----------------------------------------------------------------------------
# When unset, /status stays in honest prelaunch mode (data-mode=prelaunch).
# docker-compose defaults these to in-network health endpoints for web + gateway.
# STATUS_PROBE_WEB_URL=http://web:3001/api/health
# STATUS_PROBE_API_URL=http://api-gateway:3000/health
# STATUS_PROBE_AUTH_URL=http://api-gateway:3000/health/live
STATUS_PROBE_WEB_URL=
STATUS_PROBE_API_URL=
STATUS_PROBE_AUTH_URL=

# -----------------------------------------------------------------------------
# Keycloak IdP (canonical — ADR-001)
# Product identity is Keycloak OIDC. Set ISSUER + CLIENT_ID so the API gateway
# verifies RS256 via JWKS. Omit both only for headless CI (local HS-JWT fallback).
# Compose service `keycloak` imports infra/keycloak/proctira-realm.json.
# Live Twilio SMS requires TWILIO_*; otherwise OTP uses the console provider.
# -----------------------------------------------------------------------------
KEYCLOAK_ISSUER=http://localhost:8080/realms/proctira
KEYCLOAK_CLIENT_ID=proctira-gateway
KEYCLOAK_CLIENT_SECRET=proctira-gateway-dev-secret
KEYCLOAK_REALM=proctira
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
# KEYCLOAK_AUDIENCE=
# KEYCLOAK_JWKS_URI=   # defaults to ${KEYCLOAK_ISSUER}/protocol/openid-connect/certs
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
NEXT_PUBLIC_WEB_URL=http://localhost:3201
MFA_EXPOSE_OTP=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Database backup encryption & offsite (W1-OPS-04) — see docs/BACKUP_RESTORE.md §3.6
# -----------------------------------------------------------------------------
# BACKUP_DATABASE_URL=postgresql://proctira_backup:...@postgres:5432/proctira
# BACKUP_DIR=/backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_AGE_RECIPIENT=age1...           # age public key (encrypt at rest)
# BACKUP_AGE_IDENTITY_FILE=/secure/backup-recipient.txt  # restore only
# BACKUP_ENCRYPT=1                       # fail closed when keys missing
# BACKUP_OFFSITE_URI=s3://proctira-backups/pg/
# BACKUP_S3_SSE=AES256
# BACKUP_S3_SSE_KMS_KEY_ID=
