{
  "version": 1,
  "description": "W1-DATA-11 COMPLETE \u2014 explicit proctira_app table privilege classes. Every public table must appear here; unauthorized or unclassified privileges fail the CI catalog gate.",
  "classes": {
    "denied": {
      "privileges": [],
      "notes": "Migrator/control ledgers \u2014 no SELECT or DML for runtime"
    },
    "select_insert": {
      "privileges": ["SELECT", "INSERT"],
      "notes": "Platform-global catalogs \u2014 no UPDATE/DELETE/TRUNCATE/TRIGGER"
    },
    "append_only": {
      "privileges": ["SELECT", "INSERT"],
      "notes": "Application-written immutable ledgers/audits \u2014 SELECT+INSERT only"
    },
    "trigger_owned": {
      "privileges": ["SELECT"],
      "notes": "Trigger-written immutable audits \u2014 runtime reads parent-trigger output but cannot append duplicates"
    },
    "dml": {
      "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "notes": "Normal tenant/domain tables under RLS"
    }
  },
